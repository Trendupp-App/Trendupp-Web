# Normalize line endings to LF for all text files in the repository.
# This ensures consistent LF line endings across Windows, macOS, and Linux,
# and aligns with the `"endOfLine": "lf"` setting in .prettierrc.

* text=auto eol=lf

# Explicitly force LF for source code
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.mjs   text eol=lf
*.sh    text eol=lf
*.env*  text eol=lf

# Binary files - no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.otf   binary
